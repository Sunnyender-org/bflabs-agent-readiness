{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bflabs-agent-readiness",
  "account_id": "ae2e9fc7cd28528a178c6fb4ce9debb9",
  "main": ".worker-build/worker-entry.mjs",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "readiness.bflabs.cn",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD",
      "id": "dcbe6382f87842cf8b7ebcd82961d768"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIENT_RATE_LIMITER",
      "namespace_id": "18851",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "TARGET_RATE_LIMITER",
      "namespace_id": "18852",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
