{
  "schema_version": "0.1.0",
  "origin": "https://beefapi.com",
  "mcp_url": "https://beefapi.com/mcp",
  "tasks": [
    {
      "id": "find-model",
      "tool": "search_models",
      "arguments": {"query": "gpt-5.6", "limit": 3},
      "read_only": true,
      "expected_contains": ["gpt-5.6-sol", "pricing_version"]
    },
    {
      "id": "get-price",
      "tool": "get_model_pricing",
      "arguments": {"model_name": "gpt-5.6-sol"},
      "read_only": true,
      "expected_contains": ["gpt-5.6-sol", "pricing_version"]
    },
    {
      "id": "compare-groups",
      "tool": "compare_groups",
      "arguments": {"model_name": "gpt-5.6-sol"},
      "read_only": true,
      "expected_contains": ["price_estimates", "public_groups"]
    },
    {
      "id": "estimate-cost",
      "tool": "estimate_request_cost",
      "arguments": {"model_name": "gpt-5.6-sol", "group": "gpt-plus", "input_tokens": 1000, "output_tokens": 500},
      "read_only": true,
      "expected_contains": ["total_cny", "formula"]
    },
    {
      "id": "integration-guide",
      "tool": "get_integration_guide",
      "arguments": {"topic": "quickstart"},
      "read_only": true,
      "expected_contains": ["steps", "links"]
    }
  ]
}
