{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/discovery-brief.schema.json",
  "type": "object",
  "required": ["schema_version", "capability", "captured_at", "language", "subject", "seed_queries", "audiences", "scenarios", "comparison_targets", "covered_dimensions", "priority_dimensions", "evidence_sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capability": { "const": "geo-discover" },
    "captured_at": { "type": "string", "format": "date-time" },
    "language": { "enum": ["zh-CN", "en"] },
    "subject": { "type": "string", "minLength": 1 },
    "seed_queries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "comparison_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "covered_dimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "query-map.schema.json#/$defs/dimension" } },
    "priority_dimensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "query-map.schema.json#/$defs/dimension" } },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary", "source_type", "locator", "captured_at", "content_hash", "support_scope", "limitations", "dynamic_fact", "fact_version", "license"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ev_[a-z0-9_-]+$" },
          "summary": { "type": "string", "minLength": 1 },
          "source_type": { "enum": ["repository", "public-url", "user-supplied-observation", "fixture", "research"] },
          "locator": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "support_scope": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "dynamic_fact": { "type": "boolean" },
          "fact_version": { "type": ["string", "null"] },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
