{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/capabilities-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "capability.schema.json" }
    }
  }
}
