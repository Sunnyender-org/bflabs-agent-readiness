{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/content-spec.schema.json",
  "type": "object",
  "required": ["schema_version", "mode", "subject", "title", "audience", "intent", "document_format", "sections", "claim_ids", "discovery_context", "publication_gate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "mode": { "$ref": "content-brief.schema.json#/$defs/mode" },
    "subject": { "type": "string" },
    "title": { "type": "string" },
    "audience": { "type": "string" },
    "intent": { "type": "string" },
    "document_format": { "const": "markdown" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading", "purpose", "claim_ids"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "heading": { "type": "string" },
          "purpose": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "discovery_context": { "$ref": "content-brief.schema.json#/properties/discovery_context" },
    "publication_gate": { "const": "owner-approval-required" }
  }
}
