{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/capability.schema.json",
  "type": "object",
  "required": ["id", "version", "status", "intents", "languages", "entrypoint", "execution", "input_schema", "outputs", "permissions", "external_gates", "degrades_to"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["active", "planned", "disabled", "deprecated"] },
    "intents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "entrypoint": { "type": ["string", "null"] },
    "execution": { "enum": ["agent", "local", "offline", "external-gated"] },
    "input_schema": { "type": ["string", "null"] },
    "outputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "external_gates": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "degrades_to": { "type": "string" }
  }
}
