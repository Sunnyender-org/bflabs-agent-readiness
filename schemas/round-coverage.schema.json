{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/round-coverage.schema.json",
  "type": "object",
  "required": ["schema_version", "questions_version", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "questions_version": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageRow" }
    }
  },
  "$defs": {
    "coverageRow": {
      "type": "object",
      "required": [
        "question_cluster",
        "priority",
        "question_ids",
        "fact_ids",
        "url",
        "evidence_ref",
        "disposition",
        "status",
        "action_ids",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "question_cluster": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "question_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^q_[a-z0-9_-]+$" }
        },
        "fact_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^fact_[a-z0-9_-]+$" }
        },
        "url": { "type": ["string", "null"], "format": "uri" },
        "evidence_ref": { "type": ["string", "null"] },
        "disposition": {
          "enum": [
            "keep_existing",
            "update_existing",
            "new_page",
            "deferred",
            "not_applicable"
          ]
        },
        "status": {
          "enum": [
            "unmapped",
            "planned",
            "blueprint_ready",
            "changed_local",
            "released",
            "verified_public",
            "deferred"
          ]
        },
        "action_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^act_[a-z0-9_-]+$" }
        },
        "note": { "type": "string" }
      }
    }
  }
}
