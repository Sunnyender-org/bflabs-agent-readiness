{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/measurement-input.schema.json",
  "type": "object",
  "required": ["schema_version", "capability", "captured_at", "site_domain", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capability": { "const": "geo-measure" },
    "captured_at": { "type": "string", "format": "date-time" },
    "site_domain": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "questions_version": { "type": "string", "minLength": 1 },
    "baseline_round_id": { "type": "string", "minLength": 1 },
    "sample_slot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "planned_slots_per_question": { "type": "integer", "minimum": 1, "default": 3 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action_id", "released_at", "release_evidence"],
        "additionalProperties": false,
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "released_at": { "type": "string", "format": "date-time" },
          "release_evidence": { "type": ["string", "null"] }
        }
      }
    },
    "notes": { "type": "string" },
    "observations": { "type": "array", "items": { "$ref": "observation.schema.json" } }
  }
}
