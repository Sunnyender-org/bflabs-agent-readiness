{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/run-manifest.schema.json",
  "type": "object",
  "required": ["protocol_version", "run_id", "capability", "capability_version", "workflow_id", "created_at", "input_hash", "status", "degradation", "external_gates", "artifacts", "replay_command"],
  "additionalProperties": false,
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$" },
    "capability": { "type": "string" },
    "capability_version": { "type": "string" },
    "workflow_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "input_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["pass", "pass_with_warnings"] },
    "degradation": { "type": ["string", "null"] },
    "external_gates": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "media_type", "schema"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "enum": ["application/json", "text/markdown; charset=utf-8"] },
          "schema": { "type": ["string", "null"] }
        }
      }
    },
    "replay_command": { "type": "string" }
  }
}
