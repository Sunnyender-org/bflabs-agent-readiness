{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/evidence-ledger.schema.json",
  "type": "object",
  "required": ["schema_version", "items", "claims"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "source_type", "locator", "captured_at", "content_hash", "support_scope", "limitations", "dynamic_fact", "fact_version", "license"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "source_type": { "enum": ["repository", "public-url", "user-supplied-observation", "fixture", "research"] },
          "locator": { "type": "string" },
          "captured_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "support_scope": { "type": "string" },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "dynamic_fact": { "type": "boolean" },
          "fact_version": { "type": ["string", "null"] },
          "license": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_ids", "support_level"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "support_level": { "enum": ["direct", "derived", "context-only", "unsupported"] }
        }
      }
    }
  }
}
