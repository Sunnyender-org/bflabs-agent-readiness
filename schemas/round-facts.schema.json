{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/round-facts.schema.json",
  "type": "object",
  "required": ["schema_version", "facts_version", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "facts_version": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "statement",
        "category",
        "source_url",
        "source_captured_at",
        "source_hash",
        "evidence_status",
        "conflict_note",
        "last_reviewed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_id": { "type": "string", "pattern": "^fact_[a-z0-9_-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["identity", "audience", "capability", "domain", "pricing", "integration", "limitation", "other"]
        },
        "source_url": { "type": "string", "format": "uri" },
        "source_captured_at": { "type": "string", "format": "date-time" },
        "source_hash": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "evidence_status": {
          "enum": ["official", "third_party", "unverified", "conflict", "forbidden"]
        },
        "conflict_note": { "type": ["string", "null"] },
        "last_reviewed_at": { "type": "string", "format": "date-time" },
        "effective_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": "string", "format": "date-time" },
        "content_updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
