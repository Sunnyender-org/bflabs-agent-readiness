{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/workflows-registry.schema.json",
  "type": "object",
  "required": ["schema_version", "workflows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "status": { "enum": ["active", "planned", "disabled", "deprecated"] },
          "steps": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        }
      }
    }
  }
}
