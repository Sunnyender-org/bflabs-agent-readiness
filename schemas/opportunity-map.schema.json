{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/opportunity-map.schema.json",
  "type": "object",
  "required": ["schema_version", "subject", "scoring_method", "opportunities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "subject": { "type": "string" },
    "scoring_method": { "const": "coverage_gap(0-2) + evidence_gap(0-1) + business_relevance(1-3)" },
    "opportunities": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "dimension", "query_ids", "coverage_state", "coverage_gap", "evidence_gap", "business_relevance", "priority_score", "search_volume", "trace"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "dimension": { "$ref": "query-map.schema.json#/$defs/dimension" },
          "query_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "coverage_state": { "enum": ["covered", "partial", "missing", "unknown"] },
          "coverage_gap": { "type": "integer", "minimum": 0, "maximum": 2 },
          "evidence_gap": { "type": "integer", "minimum": 0, "maximum": 1 },
          "business_relevance": { "type": "integer", "minimum": 1, "maximum": 3 },
          "priority_score": { "type": "integer", "minimum": 1, "maximum": 6 },
          "search_volume": {
            "type": "object",
            "required": ["status", "value"],
            "additionalProperties": false,
            "properties": {
              "status": { "const": "not_measured" },
              "value": { "type": "null" }
            }
          },
          "trace": {
            "type": "object",
            "required": ["source_query_ids", "basis"],
            "additionalProperties": false,
            "properties": {
              "source_query_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
