{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/seo-official-sources.schema.json",
  "type": "object",
  "required": ["schema_version", "checked_at", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "checked_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "organization", "topic", "url", "http_status", "captured_at", "content_hash", "freshness_days", "limitations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "organization": { "enum": ["Google", "Microsoft Bing", "IndexNow", "OpenAI"] },
          "topic": { "type": "string" },
          "url": { "type": "string" },
          "http_status": { "const": 200 },
          "captured_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "freshness_days": { "type": "integer", "minimum": 1 },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
