{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/round-questions.schema.json",
  "type": "object",
  "required": ["schema_version", "questions_version", "language", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "questions_version": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "question_id",
        "observation_line",
        "intent_tag",
        "text",
        "provides_url",
        "asks_for_browsing",
        "required_fact_ids",
        "critical_error_fact_ids",
        "partial_credit_rule",
        "frozen_at"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": { "type": "string", "pattern": "^q_[a-z0-9_-]+$" },
        "observation_line": { "enum": ["A", "B", "C", "D"] },
        "intent_tag": { "enum": ["brand", "category", "compare", "evaluate", "act"] },
        "text": { "type": "string", "minLength": 1 },
        "provides_url": { "type": "boolean" },
        "asks_for_browsing": { "type": "boolean" },
        "required_fact_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^fact_[a-z0-9_-]+$" }
        },
        "critical_error_fact_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^fact_[a-z0-9_-]+$" }
        },
        "partial_credit_rule": { "type": "string", "minLength": 1 },
        "frozen_at": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "query-map.schema.json#/$defs/provenance" }
      }
    }
  }
}
