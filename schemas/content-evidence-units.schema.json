{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/content-evidence-units.schema.json",
  "type": "object",
  "required": ["schema_version", "units"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "evidence_ids", "support_level", "dynamic_fact", "fact_version", "evidence_hash"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "support_level": { "enum": ["direct", "derived"] },
          "dynamic_fact": { "type": "boolean" },
          "fact_version": { "type": ["string", "null"] },
          "evidence_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
