{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/query-map.schema.json",
  "type": "object",
  "required": ["schema_version", "subject", "language", "queries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["1.0.0", "1.1.0"] },
    "subject": { "type": "string" },
    "language": { "enum": ["zh-CN", "en"] },
    "core_question_gaps": {"type": "array", "items": {"type": "object", "required": ["question_type", "reason"], "additionalProperties": false, "properties": {"question_type": {"type": "string"}, "reason": {"type": "string"}}}},
    "queries": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "text", "dimension", "trace", "assumptions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "dimension": { "$ref": "#/$defs/dimension" },
          "trace": {
            "type": "object",
            "required": ["source_type", "source_value", "evidence_id"],
            "additionalProperties": false,
            "properties": {
              "source_type": { "enum": ["seed", "input", "assumption"] },
              "source_value": { "type": "string" },
              "evidence_id": { "type": ["string", "null"] }
            }
          },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "question_group": {"enum": ["core", "business_extension", "supplied_seed"]},
          "observation_line": {"enum": ["A", "B", "C", "D"]},
          "intent_tag": {"enum": ["brand", "category", "compare", "evaluate", "act"]},
          "purpose": {"type": "string"},
          "judgement": {"type": "string"},
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "enum": ["audience", "scenario", "comparison", "decision", "price-cost", "integration", "limitation"]
    },
    "sourceKind": {
      "enum": ["user_reported", "support", "onsite_search", "platform_export", "agent_hypothesis"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_kind", "captured_at", "market", "redacted"],
      "additionalProperties": false,
      "properties": {
        "source_kind": { "$ref": "#/$defs/sourceKind" },
        "captured_at": { "type": "string", "format": "date-time" },
        "market": { "type": "string", "minLength": 1 },
        "redacted": { "type": "boolean" }
      }
    }
  }
}
