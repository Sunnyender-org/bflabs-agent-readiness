{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bflabs.dev/schemas/content-brief.schema.json",
  "type": "object",
  "required": ["schema_version", "capability", "captured_at", "language", "mode", "subject", "audience", "intent", "facts", "evidence_sources", "comparison_targets", "comparison_dimensions", "ranking_method", "source_markdown", "discovery_context"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "capability": { "const": "geo-content" },
    "captured_at": { "type": "string", "format": "date-time" },
    "language": { "enum": ["zh-CN", "en"] },
    "mode": { "$ref": "#/$defs/mode" },
    "subject": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "comparison_targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "comparison_dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "ranking_method": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["title", "criteria", "dataset_scope"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "dataset_scope": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "source_markdown": { "type": ["string", "null"] },
    "discovery_context": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["evidence_id", "opportunity_ids", "query_ids"],
          "additionalProperties": false,
          "properties": {
            "evidence_id": { "type": "string" },
            "opportunity_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "query_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ]
    }
  },
  "$defs": {
    "mode": { "enum": ["title", "explainer", "comparison", "ranking", "page-blueprint", "refine", "article-friendly"] },
    "fact": {
      "type": "object",
      "required": ["id", "text", "evidence_ids", "support_level", "dynamic_fact", "fact_version", "evidence_hash"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^fact_[a-z0-9_-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "support_level": { "enum": ["direct", "derived"] },
        "dynamic_fact": { "type": "boolean" },
        "fact_version": { "type": ["string", "null"] },
        "evidence_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "summary", "source_type", "locator", "captured_at", "content_hash", "support_scope", "limitations", "dynamic_fact", "fact_version", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ev_[a-z0-9_-]+$" },
        "summary": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["repository", "public-url", "user-supplied-observation", "fixture", "research"] },
        "locator": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "support_scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "dynamic_fact": { "type": "boolean" },
        "fact_version": { "type": ["string", "null"] },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
